# OpenAI API key used for document analysis and draft generation.
OPENAI_API_KEY=your_openai_api_key_here

# Default model for backend AI requests.
OPENAI_MODEL=gpt-5.4-mini

# Local SQLite database for the MVP backend.
DATABASE_URL=sqlite:///./welfair_ai.db

# Where uploaded files are stored on the backend.
STORAGE_DIR=./storage/uploads

# Frontend origin allowed to call the API during local development.
CORS_ORIGINS=http://localhost:3000

# Shared API prefix for backend routes.
API_PREFIX=/api

# Number of days resolved cases stay archived before clearing.
RESOLVED_RETENTION_DAYS=21
